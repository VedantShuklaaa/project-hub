# Copy to .env.local and fill in as needed. Never put secrets in NEXT_PUBLIC_* —
# those values are inlined into the client bundle.

# Canonical origin of this app (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://projects.vedantshukla.in

# Main site origin, linked from the navbar (Home, Writings).
NEXT_PUBLIC_MAIN_SITE_URL=https://vedantshukla.in

# Public API origin allowed by the Content-Security-Policy.
NEXT_PUBLIC_API_URL=https://api.vedantshukla.in

# Optional resume link shown in the navbar. Omit to hide the item.
NEXT_PUBLIC_RESUME_URL=

# Server-only deployment origins for project rewrites (one per entry in projects.ts).
# These can hold private Vercel URLs and must NOT be prefixed with NEXT_PUBLIC_.
LOBSTER_ORIGIN=
STREAMEX_ORIGIN=
